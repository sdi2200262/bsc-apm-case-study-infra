# Restart the mock CAS service to clear its in-memory ticket state.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX="$(cd "$SCRIPT_DIR/.." && pwd)"

step() { echo "==> $*"; }

step "restarting sso service"
exec docker compose -f "$PREFIX/compose.yaml" restart sso
