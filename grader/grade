"""
Grader Entry Point

Orchestrates the grading pipeline for evaluating participant submissions.
Processes patch files (or tests baseline), runs tests against OpenEclass,
and generates reports.

Usage:
    ./grade <patch_file>           # Grade a patch submission
    ./grade --no-patch             # Test baseline (no changes)
    ./grade <patch_file> --verbose # Show individual test results
    ./grade <patch_file> --debug   # Debug server communication
"""

import sys
import os
import argparse
from pathlib import Path

# Add grader directory to Python path for imports
GRADER_DIR = Path(__file__).parent.resolve()
sys.path.insert(0, str(GRADER_DIR))

from src.patch_manager import PatchManager
from src.build_tester import BuildTester
from src.memory_tester import MemoryTester
from src.mock_server import MockServerManager
from src.eclass_manager import EclassManager
from src.protocol_tester import ProtocolTester
from src.scorer import Scorer
from src.report import ReportWriter


def main():
    parser = argparse.ArgumentParser(
        description="Grade participant submissions for eclass-mcp-server"
    )
    parser.add_argument(
        "patch_file", 
        nargs="?",
        default=None,
        help="Path to the patch file to evaluate (omit with --no-patch)"
    )
    parser.add_argument(
        "--no-patch", 
        action="store_true",
        help="Test baseline without applying any patch"
    )
    parser.add_argument(
        "--no-cleanup", 
        action="store_true", 
        help="Keep test branch after grading"
    )
    parser.add_argument(
        "--verbose", "-v", 
        action="store_true",
        help="Show individual test results in console output"
    )
    parser.add_argument(
        "--debug", 
        action="store_true",
        help="Enable debug output (internal server communication)"
    )
    
    args = parser.parse_args()
    debug = args.debug
    
    # Validate arguments
    if not args.no_patch and not args.patch_file:
        parser.error("Either provide a patch file or use --no-patch")
    
    if args.no_patch and args.patch_file:
        parser.error("Cannot use --no-patch with a patch file")
    
    # Determine patch path and name
    if args.no_patch:
        patch_path = None
        patch_name = "baseline"
    else:
        patch_path = Path(args.patch_file).resolve()
        if not patch_path.exists():
            print(f"Error: Patch file not found: {patch_path}", file=sys.stderr)
            sys.exit(1)
        patch_name = patch_path.stem
    
    # Determine workspace paths
    workspace_root = GRADER_DIR.parent
    eclass_dir = workspace_root / "eclass-mcp-server"
    
    if not eclass_dir.exists():
        print(f"Error: eclass-mcp-server directory not found at {eclass_dir}", file=sys.stderr)
        sys.exit(1)
    
    print("=" * 50)
    print(f"Grading: {patch_name}")
    print("=" * 50)
    
    # Initialize components
    scorer = Scorer()
    report = ReportWriter(workspace_root, patch_name)
    patch_manager = PatchManager(eclass_dir)
    
    # Check prerequisites
    print("\n[1/8] Checking prerequisites...")
    eclass_manager = EclassManager()
    if not eclass_manager.start():
        print("\nError: Prerequisites not met.")
        print("Ensure OpenEclass is running: docker start grader_db_1 grader_eclass_1")
        sys.exit(1)
    
    try:
        # Apply patch (if provided)
        if patch_path:
            print("\n[2/8] Applying patch...")
            success, message = patch_manager.create_branch_and_apply_patch(patch_path)
            if not success:
                print(f"  FAIL: {message}")
                scorer.record("PATCH", False, message, message)
                _finalize_and_exit(scorer, report, args.verbose)
            print(f"  OK: {message}")
        else:
            print("\n[2/8] Testing baseline (no patch)...")
            print("  OK: Using current main branch state")
        
        # Python build test
        print("\n[3/8] Testing Python build...")
        build_tester = BuildTester(eclass_dir)
        py_build_ok, py_build_msg = build_tester.test_python_build()
        scorer.record("B1", py_build_ok, py_build_msg, py_build_msg)
        print(f"  {'OK' if py_build_ok else 'FAIL'}: {py_build_msg[:80]}")
        
        if not py_build_ok:
            print("\n  Python build failed. Skipping Python tests.")
            _skip_python_tests(scorer)
        else:
            # Start SSO mock server
            print("\n[4/8] Running Python baseline tests...")
            sso_mock = MockServerManager(port=8082)
            sso_mock.start()
            
            try:
                tester = ProtocolTester(eclass_dir, sso_mock.get_env(), debug=debug)
                
                # Python baseline tests
                results = tester.run_python_baseline_tests()
                for test_id, (passed, msg, full) in results.items():
                    scorer.record(test_id, passed, msg, full)
                    if debug or args.verbose:
                        print(f"    {'OK' if passed else 'FAIL'} {test_id}: {msg[:60]}")
                
                py_baseline = scorer.get_python_baseline_score()
                print(f"  Python Baseline Score: {py_baseline[0]}/{py_baseline[1]}")
                
                # Python feature tests
                print("\n[5/8] Running Python feature tests...")
                results = tester.run_python_feature_tests()
                for test_id, (passed, msg, full) in results.items():
                    scorer.record(test_id, passed, msg, full)
                    if debug or args.verbose:
                        print(f"    {'OK' if passed else 'FAIL'} {test_id}: {msg[:60]}")
                
                py_feature = scorer.get_python_feature_score()
                print(f"  Python Feature Score: {py_feature[0]}/{py_feature[1]}")
                
            finally:
                sso_mock.stop()
        
        # C build test
        print("\n[6/8] Testing C build...")
        c_build_ok, c_build_msg = build_tester.test_c_build()
        scorer.record("B2", c_build_ok, c_build_msg, c_build_msg)
        print(f"  {'OK' if c_build_ok else 'FAIL'}: {c_build_msg[:80]}")
        
        if not c_build_ok:
            print("\n  C build failed. Skipping C tests.")
            _skip_c_tests(scorer)
        else:
            # Memory test
            print("\n[7/8] Running C memory tests...")
            
            # Start mock for memory tests
            sso_mock = MockServerManager(port=8082)
            sso_mock.start()
            
            try:
                memory_tester = MemoryTester(eclass_dir, sso_mock.get_env())
                mem_ok, mem_msg = memory_tester.test_valgrind()
                scorer.record("M1", mem_ok, mem_msg, mem_msg)
                print(f"  {'OK' if mem_ok else 'FAIL'}: {mem_msg[:80]}")
            finally:
                sso_mock.stop()
            
            # C protocol and tool tests
            print("\n[8/8] Running C protocol and tool tests...")
            sso_mock = MockServerManager(port=8082)
            sso_mock.start()
            
            try:
                tester = ProtocolTester(eclass_dir, sso_mock.get_env(), debug=debug)
                
                # C baseline tests
                results = tester.run_c_baseline_tests()
                for test_id, (passed, msg, full) in results.items():
                    scorer.record(test_id, passed, msg, full)
                    if debug or args.verbose:
                        print(f"    {'OK' if passed else 'FAIL'} {test_id}: {msg[:60]}")
                
                # C feature tests
                results = tester.run_c_feature_tests()
                for test_id, (passed, msg, full) in results.items():
                    scorer.record(test_id, passed, msg, full)
                    if debug or args.verbose:
                        print(f"    {'OK' if passed else 'FAIL'} {test_id}: {msg[:60]}")
                
                c_total = scorer.get_c_score()
                print(f"  C Replica Score: {c_total[0]}/{c_total[1]}")
                
            finally:
                sso_mock.stop()
        
        # Generate reports
        report.write_json(scorer)
        report.write_text(scorer)
        report.print_console_summary(scorer, args.verbose)
        
    finally:
        # Cleanup (only if we applied a patch)
        if patch_path and not args.no_cleanup:
            print("\nCleaning up...")
            patch_manager.cleanup()


def _skip_python_tests(scorer: Scorer) -> None:
    """Record skipped results for all Python tests."""
    python_tests = ["P1", "P2", "L1", "L2", "L3", "O1", "O2", "C1", "C2", "A1",
                   "AN1", "AN2", "AN3", "AN4", "AN5"]
    for test_id in python_tests:
        scorer.record(test_id, False, "Skipped - Python build failed", "Build failed")


def _skip_c_tests(scorer: Scorer) -> None:
    """Record skipped results for all C tests."""
    c_tests = ["M1", "P1_c", "P2_c", "L1_c", "L2_c", "L3_c", "O1_c", "O2_c", 
               "C1_c", "C2_c", "A1_c", "AN1_c", "AN2_c", "AN3_c", "AN4_c", "AN5_c"]
    for test_id in c_tests:
        scorer.record(test_id, False, "Skipped - C build failed", "Build failed")


def _finalize_and_exit(scorer: Scorer, report: ReportWriter, verbose: bool) -> None:
    """Finalize reports and exit with error."""
    report.write_json(scorer)
    report.write_text(scorer)
    report.print_console_summary(scorer, verbose)
    sys.exit(1)


if __name__ == "__main__":
    main()
